{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "dialog:default",
    "fs:default",
    { "identifier": "fs:allow-read-file",       "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-write-text-file",  "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-mkdir",            "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-exists",           "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-stat",             "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-dir",         "allow": [{ "path": "**" }] }
  ]
}
